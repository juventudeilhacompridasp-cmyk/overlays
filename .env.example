# Porta acessada no computador hospedeiro.
OVERLAY_PORT=4173

# As variáveis abaixo só são necessárias para execução sem Docker.
HOST=0.0.0.0
PORT=4173
OVERLAY_STATE_FILE=.data/overlay-state.json

# Opcional no Node/Docker: segredo aleatório (32+ caracteres) para o primeiro cadastro.
# Se omitido, o código local aparece no terminal. Nunca versione seu valor real.
# OVERLAY_SETUP_TOKEN=
